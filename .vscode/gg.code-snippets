    "newcomp": {
        "scope": "lua",
        "prefix": "newcomp",
        "description": "Boilerplate for a new Component file.",
        "body": [
            "---@class ComponentSet",
            "---@field $1 $1",
            "",
            "---@class ${1:ComponentName} : Component",
            "$1 = class(\"$1\").extends(Component) or $1",
            "${1/(.*)/${1:/upcase}/} = $1.className",
            "",
            "function $1:init()",
            "\t$1.super.init(self)",
            "end",
            "",
            "function $1:__tostring()",
            "\treturn ${1/(.*)/${1:/upcase}/}",
            "end",
            "",
            "---@param entityId integer",
            "---@return $1",
            "function $1.get(entityId)",
            "\treturn World:getComponent(entityId, ${1/(.*)/${1:/upcase}/})",
            "end",
        ],
    },
    "newsys": {
        "scope": "lua",
